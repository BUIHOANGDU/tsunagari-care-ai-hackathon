# Tsunagari Bridge API environment example.
# Copy this file to .env for local development and fill in local values.
# Do not commit .env, service account JSON, tokens, family codes, or private keys.

PORT=

# Backend device authentication.
TSUNAGARI_DEVICE_TOKEN=

# Firebase Admin SDK. FIREBASE_SERVICE_ACCOUNT_JSON should contain the full
# service account JSON as a single environment variable. Keep escaped newlines
# in the private_key value as \n.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# LINE Messaging API caregiver notifications.
LINE_MESSAGING_ENABLED=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CAREGIVER_USER_IDS=
LINE_NOTIFICATION_DEMO_ENABLED=
HEALTH_CONCERN_LINE_ENABLED=
HEALTH_CONCERN_STORE_TRANSCRIPT=

# Family viewer session access.
FAMILY_ACCESS_CODE_HASH=
FAMILY_ACCESS_CODE=
FAMILY_SESSION_TTL_MINUTES=
FAMILY_SESSION_RATE_LIMIT_WINDOW_MS=
FAMILY_SESSION_RATE_LIMIT_MAX=

# Realtime Database retention.
RTDB_HISTORY_MAX_RECORDS=

# Weather widget. Open-Meteo is used server-side and does not require an API key.
WEATHER_LOCATION_NAME=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=
WEATHER_CACHE_MINUTES=
